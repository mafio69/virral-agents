# Aplikacja
APP_ENV=dev
APP_DEBUG=true

# Docker / nginx
APP_HOST=localhost
APP_PORT=8080

# SQLite
DB_PATH=/var/www/var/database/app.sqlite

# OVH AI Endpoints
OVH_AI_BASE_URI=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1/
OVH_AI_MODEL=Qwen3-Coder-30B-A3B-Instruct
OVH_AI_ENDPOINTS_ACCESS_TOKEN=your_token_here
OVH_AI_TIMEOUT=60

#### OPENCODE GO
OPENCODE_GO_API_KEY=oc_sk_********************************************
OPENCODE_GO_DEFAULT_MODEL=deepseek-v4-pro
OPENCODE_GO_URL=https://opencode.ai/inference/openai/v1/chat/completions
#### EXAMPLE
#curl -X POST "https://opencode.ai/inference/openai/v1/chat/completions" \
#  -H "Authorization: Bearer $OPENCODE_API_KEY" \
#  -H "Content-Type: application/json" \
#  -d '{ "model": "kimi-k2.6", "messages": [{ "role": "user", "content": "Say hi" }] }'

# DeepSeek
# base_url (OpenAI)	https://api.deepseek.com
# base_url (Anthropic)	https://api.deepseek.com/anthropic
# api_key	apply for an API key
# deepseek-flash
# deepseek-v4-pro
#
#curl https://api.deepseek.com/chat/completions \
#  -H "Content-Type: application/json" \
#  -H "Authorization: Bearer ${DEEPSEEK_API_KEY}" \
#  -d '{
#        "model": "deepseek-flash",
#        "messages": [
#          {"role": "system", "content": "You are a helpful assistant."},
#          {"role": "user", "content": "Hello!"}
#        ],
#        "thinking": {"type": "enabled"},
#        "reasoning_effort": "high",
#        "stream": false
#      }'
# 1M INPUT TOKENS PEAK / off 50%opencode
#
# 01:00–04:00 UTC → 02:00–05:00.
#
# 06:00–10:00 UTC → 07:00–11:00.
#
#

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_BASE_URL_ANTHROPIC=https://api.deepseek.com/anthropic

# Logger
LOG_LEVEL=warning

# Mail (MailPit — dev)
MAIL_DSN=smtp://host.docker.internal:1025
APP_URL=http://localhost:8181

# Logowanie
PASSWORD_HASH_ALGO=sha256
SESSION_EXPIRE_HOURS=24

# Langfuse (ślady czatu: tylko liczby i metadane, bez treści) — klucze z projektu: Settings → API Keys.
# WYMAGANE do wysyłki: LANGFUSE_ENABLED=true (bez tego aplikacja nic nie wysyła; log mówi „Langfuse wyłączony”).
# Po zmianie: ./dev-start.sh (odtworzenie kontenera app). Weryfikacja: wpis w logu aplikacji + panel Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# adres: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US) albo własna instalacja;
# LANGFUSE_HOST ma pierwszeństwo przed LANGFUSE_BASE_URL, domyślnie EU
LANGFUSE_BASE_URL=
LANGFUSE_HOST=
# opcjonalnie wersja aplikacji (np. hash commita) — pole „release” w Langfuse
LANGFUSE_RELEASE=
