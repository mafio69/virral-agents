{
  "name": "mariusz/slim-ovh-ai",
  "description": "Slim API for AI conversations, approved web research, and task management.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.8",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "vlucas/phpdotenv": "^5.6",
    "guzzlehttp/guzzle": "^7.9",
    "mafio69/fast-php-logger": "^1.0",
    "symfony/mailer": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "dg/bypass-finals": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "lint": "php-cs-fixer fix --config=php-cs-fixer.php --dry-run --diff --using-cache=no --sequential",
    "format": "php-cs-fixer fix --config=php-cs-fixer.php --using-cache=no --sequential",
    "test-ui": "node --test --test-isolation=none tests/ui/*.test.mjs",
    "check-all": [
      "@lint",
      "@test",
      "@test-ui"
    ]
  }
}
